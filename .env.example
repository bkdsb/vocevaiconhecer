# Runtime
NODE_ENV=development
VVC_DATA_DIR=./data
VVC_OUTPUT_DIR=./output
VVC_TIMEZONE=America/Sao_Paulo
VVC_GENERATION_TIME=08:00
VVC_DAILY_SLOTS=8
VVC_APPROVAL_REQUIRED=true

# Meta app and OAuth. Never commit real values.
META_APP_ID=1051796081025755
META_APP_SECRET=
META_API_VERSION=v26.0
META_CONFIG_ID=
META_REDIRECT_URI=https://example.invalid/auth/meta/callback
META_PAGE_ID=
META_PAGE_TOKEN=
META_PUBLISH_ENABLED=false

# Cloudflare Workers AI. The adapter only runs when the free-tier acknowledgement is true.
CF_ACCOUNT_ID=
CF_API_TOKEN=
AI_FREE_TIER_CONFIRMED=false
AI_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# OpenClaw / WhatsApp. Use a dedicated WhatsApp number and an E.164 target.
OPENCLAW_BIN=/home/ubuntu/.npm-global/bin/openclaw
OPENCLAW_WHATSAPP_TARGET=
OPENCLAW_WHATSAPP_ACCOUNT=default
OPENCLAW_ENABLED=false
VVC_BRIDGE_TOKEN=
VVC_ALLOWED_SENDERS=

# Research skill. The server setup script pins the upstream repository SHA.
LAST30DAYS_DIR=./data/last30days
LAST30DAYS_REPO=https://github.com/mvanhorn/last30days-skill.git
LAST30DAYS_SHA=084662b501fb0dba95bd55eff0c258d35e0dc499
LAST30DAYS_PYTHON=python3.12
